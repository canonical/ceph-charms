# Merge onto x86_64_defconfig. This is a disposable VM kernel, not an Ubuntu build.
CONFIG_LOCALVERSION="-cephx-sru06"
# CONFIG_LOCALVERSION_AUTO is not set

# Compile real test bodies, not stubs. KRB5=m lets each run reload its selftests.
CONFIG_DEBUG_KERNEL=y
CONFIG_CRYPTO_MANAGER=y
# CONFIG_CRYPTO_MANAGER_DISABLE_TESTS is not set
CONFIG_CRYPTO_MANAGER_EXTRA_TESTS=y
CONFIG_CRYPTO_KRB5=m
CONFIG_CRYPTO_KRB5_SELFTESTS=y

# Load/unload the helpers and reject modules built against incompatible symbols.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_CEPH_LIB=m
CONFIG_DEBUG_FS=y

# Boot the LXD VM with EFI and virtio disk/network/console devices.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_SCSI_VIRTIO=y
CONFIG_EXT4_FS=y

# No local signing keys or debug packages; compiler warnings remain visible/nonfatal.
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_MODULE_SIG_ALL is not set
# CONFIG_WERROR is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
CONFIG_DEBUG_INFO_NONE=y

# Skip unrelated hardware/filesystems to reduce build time and disk use.
# VIRTIO_NET above supplies networking even with physical ETHERNET drivers disabled.
# CONFIG_DRM is not set
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_PCCARD is not set
# CONFIG_MACINTOSH_DRIVERS is not set
# CONFIG_AGP is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_9P_FS is not set
# CONFIG_NET_9P is not set
# CONFIG_PROFILING is not set
# CONFIG_HIBERNATION is not set
# CONFIG_SCHED_MC_PRIO is not set
# CONFIG_X86_INTEL_PSTATE is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_ETHERNET is not set
